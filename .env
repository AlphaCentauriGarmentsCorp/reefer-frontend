# LOCAL DEVELOPMENT (`npm run dev`). Where this SPA finds the storefront API.
#
# The backend is ash-ai-backend, run with `php artisan serve` on :8000. Its
# storefront API is mounted under /api/storefront, and the service modules in
# src/api/ add /v1 themselves — so a call's final URL is /api/storefront/v1/....
#
# This is cross-origin (SPA on :5173, API on :8000), so the backend has to be told
# to allow this dev origin. Set STOREFRONT_ALLOWED_ORIGINS in the BACKEND's .env:
#   STOREFRONT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# On a fresh clone the allowlist is otherwise empty and the browser blocks every
# request, while curl against the same URLs returns 200.
VITE_API_URL=http://127.0.0.1:8000/api/storefront
