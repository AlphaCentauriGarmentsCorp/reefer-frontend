# LOCAL DEVELOPMENT (`npm run dev`). Where this SPA finds its API.
#
# Backend: ash-ai-backend, which mounts the REEFER storefront as an isolated module
# in app/Providers/StorefrontServiceProvider.php:
#
#     Route::prefix('api/storefront')
#         ->middleware(['api', ForceJsonResponse::class, 'throttle:storefront-api'])
#         ->group(base_path('routes/storefront.php'));
#
# So the base stops at /api/storefront and every service module in src/api/ appends its
# own /v1/... — productApi calls /v1/products, giving /api/storefront/v1/products.
#
# Do NOT put /v1 on the end here; the service modules add it and it would double.
#
# This is a SEPARATE surface from the ERP's /api/v2/*, served by the SAME app. The
# storefront has its own Customer model and its own auth under /v1/auth/*, so it never
# touches ERP accounts.
#
# Start the backend with:  php artisan serve --port=8000
#
# ---------------------------------------------------------------------------------
# PORT 8000 IS CONTESTED. Three Laravel apps want it:
#
#   ash-ai-backend        <- the one this file points at (ERP + storefront)
#   reefer-backend-mock   <- serves /api/v1/*, has NO /api/storefront
#   Reefer_Backend        <- serves /api/v1/*, has NO /api/storefront
#
# Whichever wins the port answers for it, and when the wrong one does you get 404s on
# every storefront call while the SPA itself looks perfectly healthy. Before debugging
# anything else, check WHICH app replied:
#
#     curl http://127.0.0.1:8000/api/storefront/v1/health   -> ash-ai-backend  (correct)
#     curl http://127.0.0.1:8000/api/v1/health              -> the mock / Reefer_Backend
#
# If this ever needs to move to another port, change it in ONE place — here — and
# restart Vite. It reads .env only at startup, so an edit alone does nothing.
VITE_API_URL=http://127.0.0.1:8000/api/storefront
