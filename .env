# LOCAL DEVELOPMENT (`npm run dev`). Where this SPA finds its API.
#
# Backend: Reefer_Backend  ("reefer backend/Reefer_Backend")
#     cd "reefer backend/Reefer_Backend" && php artisan serve --port=8000
#
# ONE backend now serves BOTH halves of this app, from one database (reefer_db):
#
#     /api/v1/*       the storefront    — products, cart, orders, customer auth
#     /api/stocks/*   the stock manager — inventory, catalog, staff auth
#
# They share the products and product_variants tables, which is the whole point:
# editing stock in the stock manager changes what the shop sells, immediately, with
# no sync step. The two have SEPARATE logins though — customers authenticate against
# `users`, warehouse staff against `stock_users`, and neither token works on the
# other's routes.
#
# The base stops at /api because each service module in src/api/ adds its own
# version segment — productApi calls /v1/products, the stock pages call /stocks/...
# Do NOT put /v1 on the end here; it would double.
#
# ---------------------------------------------------------------------------------
# PORT 8000 IS CONTESTED — three Laravel apps want it, and each mounts the API at a
# DIFFERENT PATH. The value below has to match whichever one actually holds the port:
#
#   ash-ai-backend       ->  .../api/storefront   (production; the storefront and the
#                                                  stock manager are modules inside the
#                                                  ERP, so everything sits under
#                                                  /api/storefront/*)
#   Reefer_Backend       ->  .../api              (standalone; /api/v1/* + /api/stocks/*)
#   reefer-backend-mock  ->  .../api              (/api/v1/* only — no stock manager)
#
# Point this at the wrong one and every call 404s while the SPA still looks healthy:
# no red errors, just empty pages. IDENTIFY THE HOLDER BEFORE EDITING — the second
# call is the one that tells them apart, because only one of the two can answer it:
#
#     curl -o /dev/null -w "%{http_code}\n" http://127.0.0.1:8000/api/v1/products
#     curl -o /dev/null -w "%{http_code}\n" http://127.0.0.1:8000/api/storefront/v1/products
#
#   200 on the FIRST  -> Reefer_Backend or the mock ->  VITE_API_URL=.../api
#   200 on the SECOND -> ash-ai-backend             ->  VITE_API_URL=.../api/storefront
#
# Both clients derive from this ONE value, which is why it has no /v1 and no /stocks
# on the end: src/api/axios.js uses it raw and each service appends /v1, while
# src/stocks/api/client.js appends /stocks. Get the base right and both halves follow.
#
# Vite reads this file ONLY at startup — changing it needs a restart, not a reload.
VITE_API_URL=http://127.0.0.1:8000/api/storefront
