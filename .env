# LOCAL DEVELOPMENT (`npm run dev`). Where this SPA finds its API.
#
# Backend: ash-ai-backend on branch feat/reefer-storefront, which mounts the REEFER
# storefront as an isolated module in app/Providers/StorefrontServiceProvider.php:
#
#     Route::prefix('api/storefront')
#         ->middleware(['api', ForceJsonResponse::class, 'throttle:storefront-api'])
#         ->group(base_path('routes/storefront.php'));
#
# So the base stops at /api/storefront and every service module in src/api/ appends its
# own /v1/... — productApi calls /v1/products, giving /api/storefront/v1/products.
#
# Do NOT put /v1 on the end here; the service modules add it and it would double.
#
# This is a SEPARATE surface from the ERP's /api/v2/*. The storefront has its own
# Customer model and its own auth under /v1/auth/*, so it never touches ERP accounts.
#
# Start the backend with:  php artisan serve --port=8080
#
# Port 8080, not 8000: reefer-backend-mock and Reefer_Backend both want 8000 and one of
# them currently holds it. Whichever Laravel app wins that port answers for it, and when
# the wrong one does, /api/storefront/* 404s while the SPA still looks fine. Running on
# 8080 sidesteps the race entirely — move this back to 8000 only if you have freed it.
#
# Confirm the right app is answering before debugging anything else:
#     curl http://127.0.0.1:8080/api/storefront/v1/health    -> ash-ai-backend storefront
#     curl http://127.0.0.1:8080/api/storefront/v1/products  -> should list 3 products
VITE_API_URL=http://127.0.0.1:8080/api/storefront
